<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms alleen voor de map-kiezer -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Edition Condition="'$(Edition)' == ''">Intern</Edition>
    <AssemblyName>NDXNexus</AssemblyName>
    <RootNamespace>NdxNexus</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nexus.ico</ApplicationIcon>
    <Product>NDX Nexus</Product>
    <Company>NDX</Company>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);WFAC010;CS0162</NoWarn>
  </PropertyGroup>

  <!-- Editie: -p:Edition=Intern (standaard) of -p:Edition=Open -->
  <PropertyGroup Condition="'$(Edition)' == 'Open'">
    <AssemblyName>Nexus</AssemblyName>
    <Product>Nexus</Product>
    <DefineConstants>$(DefineConstants);OPEN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Afbeeldingen zitten in de exe, zodat gemaakte installers één bestand zijn -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="Assets.%(Filename)%(Extension)" />
    <!-- Huisstijl-lettertypen (Montserrat, Open Sans; SIL OFL) zitten in de exe -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
